# Public deployment controls. Copy to an ignored .env.vps outside the checkout on the VPS.
VPS_DEPLOY_COMMIT=REPLACE_WITH_ACCEPTED_40_CHARACTER_COMMIT
VPS_API_IMAGE=sha256:unset
VPS_EDGE_IMAGE=sha256:unset
VPS_API_HOST=materyalph26-api.duckdns.org # Public DNS hostname; gitleaks:allow
VPS_VENDOR_HOST=materyalph26-vendor.duckdns.org
VPS_ADMIN_HOST=materyalph26-admin.duckdns.org
VPS_REVERB_HOST=materyalph26-ws.duckdns.org
VPS_API_ENV_FILE=/srv/materyalph/private/api.env
VPS_REVERB_ENV_FILE=/srv/materyalph/private/reverb.env
VPS_BACKUP_ENV_FILE=/srv/materyalph/private/backup.env
VPS_DB_OWNER_PASSWORD_FILE=/srv/materyalph/private/db-owner-password
VPS_DB_APP_PASSWORD_FILE=/srv/materyalph/private/db-app-password
VPS_BACKUP_PASSWORD_FILE=/srv/materyalph/private/backup-password
VPS_RECOVERY_DIRECTORY=/srv/materyalph/recovery
VPS_IPV4=REPLACE_WITH_CONFIRMED_VPS_IPV4
DUCKDNS_TOKEN_FILE=/srv/materyalph/private/duckdns-token
