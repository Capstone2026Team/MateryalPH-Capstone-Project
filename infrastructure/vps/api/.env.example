REDIS_QUEUE_RETRY_AFTER=90
SESSION_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUSTED_PROXIES=172.30.240.0/24
FRONTEND_VENDOR_HOST=materyalph26-vendor.duckdns.org
FRONTEND_ADMIN_HOST=materyalph26-admin.duckdns.org
