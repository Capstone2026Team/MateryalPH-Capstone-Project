FRONTEND_BUYER_REDIRECT_URI=materyalph://auth/callback
PASSPORT_PRIVATE_KEY_BASE64=
PASSPORT_PUBLIC_KEY_BASE64=
IMPORTED_DATA_RECOVERY_ENABLED=true
STAGING_LEGACY_FILES_ON_S3=true
