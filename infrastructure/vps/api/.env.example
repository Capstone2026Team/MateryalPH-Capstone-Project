APP_NAME=MateryalPH
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=https://materyalph26-api.duckdns.org
APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Asia/Manila
HASH_DRIVER=argon2id
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_REDACT_SENSITIVE=true
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=materyalph_staging
DB_USERNAME=materyalph_app
DB_PASSWORD=
DB_SSLMODE=disable
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
