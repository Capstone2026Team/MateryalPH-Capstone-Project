[Unit]
Description=MateryalPH encrypted offsite recovery snapshot
After=docker.service network-online.target
Requires=docker.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/materyalph/current
UMask=0077
ExecStart=/bin/bash /srv/materyalph/current/scripts/deployment/vpsctl.sh backup /srv/materyalph/private/control.env
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
