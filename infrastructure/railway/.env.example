# Backend-only shared variables. Enter real values only in Railway secret fields.
APP_ENV=staging
APP_DEBUG=false
APP_KEY=
APP_URL=
XENDIT_MODE=TEST
FINANCE_MODE=TEST
LIVE_COMMERCE_ENABLED=false
# Keep disabled until the import, private files and outbox have been reviewed.
STAGING_RELEASE_APPROVED=false
STAGING_DATA_READY=false
STAGING_JOBS_ENABLED=false
FRONTEND_VENDOR_HOST=
FRONTEND_ADMIN_HOST=
FRONTEND_VENDOR_URL=
FRONTEND_ADMIN_URL=
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=materyalph_staging
DB_USERNAME=materyalph_app
DB_PASSWORD=
DB_SSLMODE=require
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=150
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
MAIL_MAILER=gmail_api
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=MateryalPH Staging
MAIL_TIMEOUT_SECONDS=15
MAIL_DELIVERY_NOT_BEFORE=
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
FILESYSTEM_DISK=s3
VENDOR_PRIVATE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
STAGING_LEGACY_FILES_ON_S3=false
IMPORTED_DATA_RECOVERY_ENABLED=true
SCANNER_DRIVER=clamscan
RUN_FRESHCLAM=true
