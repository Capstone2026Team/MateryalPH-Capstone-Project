{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "infrastructure/docker/api.staging.Dockerfile" },
  "deploy": {
    "startCommand": "/usr/local/bin/staging-start reverb",
    "healthcheckPath": "/up", "healthcheckTimeout": 120,
    "region": "asia-southeast1-eqsg3a", "numReplicas": 1,
    "sleepApplication": false, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3,
    "overlapSeconds": 0, "drainingSeconds": 30,
    "limitOverride": { "containers": { "cpu": 0.5, "memoryBytes": 268435456 } }
  }
}
