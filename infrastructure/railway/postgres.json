{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "infrastructure/docker/postgres.railway.Dockerfile" },
  "deploy": {
    "region": "asia-southeast1-eqsg3a", "numReplicas": 1,
    "sleepApplication": false, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3,
    "requiredMountPath": "/var/lib/postgresql/data",
    "overlapSeconds": 0, "drainingSeconds": 60,
    "limitOverride": { "containers": { "cpu": 1, "memoryBytes": 1073741824 } }
  }
}
