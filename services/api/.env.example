APP_NAME=MateryalPH
APP_ENV=development
IMPORTED_DATA_RECOVERY_ENABLED=false
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
VENDOR_PRIVATE_DISK=local
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_REDACT_SENSITIVE=true

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=materyalph_dev
DB_USERNAME=materyalph_dev
DB_PASSWORD=
DB_SSLMODE=prefer

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_URL=redis://redis:6379

FRONTEND_BUYER_REDIRECT_URI=
FRONTEND_VENDOR_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Comma-separated proxy IPs/CIDRs, or * behind a managed TLS proxy such as Render. Empty trusts none.
TRUSTED_PROXIES=

PASSPORT_PRIVATE_KEY_BASE64=
PASSPORT_PUBLIC_KEY_BASE64=
PASSPORT_ACCESS_TOKEN_MINUTES=15
PASSPORT_REFRESH_TOKEN_DAYS=14
MFA_CHALLENGE_TTL_MINUTES=5
MFA_CHALLENGE_MAX_ATTEMPTS=5

FINANCE_MODE=
PRIVACY_CONTACT_EMAIL=privacy@example.test
WITHHOLDING_SCENARIO=
PLATFORM_TAX_PROFILE=
LIVE_COMMERCE_ENABLED=
MATERIALS_ANALYTICS_ENABLED=true
DEMO_DATASET_ID=
DEMO_DATASET_LABEL=
DEMO_DATASET_AS_OF=
# materyalph:demo-vendors-seed (development only). Mailbox base for the twelve demo Vendors' logins and Xendit TEST
# sub-accounts: name@example.com becomes name+matdemo01@example.com. Leave the password empty to have a random one
# written to storage/app/demo-vendor-credentials.json (git-ignored) on first run.
DEMO_SEED_EMAIL_BASE=
DEMO_SEED_PASSWORD=
DEMO_SEED_PHOTO_DIRECTORY=
DEMO_SEED_REGISTER_DIRECTORY=
# Seconds to wait for new Xendit TEST sub-accounts to turn LIVE so the same run can finish those Stores (0 skips).
DEMO_SEED_XENDIT_LIVE_WAIT_SECONDS=600

EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
RECENT_AUTH_TTL_MINUTES=15

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_URL=
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REQUIRE_TLS=false
MAIL_TIMEOUT_SECONDS=10
# For Gmail, set once to the UTC activation time: YYYY-MM-DDTHH:MM:SSZ.
MAIL_DELIVERY_NOT_BEFORE=
MAIL_FROM_ADDRESS=no-reply@materyalph.test
MAIL_FROM_NAME=MateryalPH

GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_OIDC_ANDROID_CLIENT_ID=
GOOGLE_OIDC_IOS_CLIENT_ID=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_TIMEOUT_SECONDS=5
GOOGLE_PLACES_ENABLED=true
GOOGLE_PLACES_INCLUDED_TYPES=hardware_store,home_improvement_store
GOOGLE_PLACES_CACHE_TTL_HOURS=168
GOOGLE_PLACES_MAX_SEARCH_CELLS=7
GOOGLE_PLACES_MAX_CALLS_PER_DAY=2000
GOOGLE_PLACES_MAX_CACHE_RECORDS=20000
GOOGLE_ROUTES_ROUTING_PREFERENCE=TRAFFIC_AWARE
GOOGLE_ROUTES_CACHE_TTL_MINUTES=10
GOOGLE_ROUTES_MAX_CALLS_PER_DAY=2000
GOOGLE_ROUTES_MAX_CACHE_RECORDS=20000

XENDIT_MODE=TEST
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_TIMEOUT_SECONDS=5
# Optional TEST business ID for PLATFORM_FEE_PAYMENT; empty uses the master TEST account.
XENDIT_PLATFORM_ACCOUNT_ID=
# xendit (TEST adapter) or fake (deterministic SIMULATED adapter for local/CI only).
PAYMENT_GATEWAY=xendit
# Hours a Buyer has to pay once the Vendor confirms an online order (Pending Payment).
ORDER_PAYMENT_WINDOW_HOURS=24

VENDOR_DOCUMENT_MAX_KB=10240
VENDOR_MEDIA_MAX_KB=20480
CATALOG_LISTING_IMAGE_MAX_KB=5120
CATALOG_COMPLIANCE_EVIDENCE_MAX_KB=10240
CATALOG_IMPORT_MAX_KB=2048

# Local PS/ICC photo assistance; no cloud credential. Set driver to none to disable.
COMPLIANCE_OCR_DRIVER=tesseract
COMPLIANCE_OCR_BINARY=tesseract
COMPLIANCE_OCR_TIMEOUT_SECONDS=15

# DTI-BPS PS/ICC register feeds (optional). Leave empty unless DTI-BPS publishes or authorizes an
# export: the official Google Sheets disable download. Without a feed, Admins import the monthly
# snapshot under Product Compliance > Registers. URLs must be https and their host allow-listed.
COMPLIANCE_REGISTER_PS_FEED_URL=
COMPLIANCE_REGISTER_ICC_FEED_URL=
COMPLIANCE_REGISTER_FEED_HOSTS=
COMPLIANCE_REGISTER_FEED_AUTO_ACTIVATE=false

RECAPTCHA_ENABLED=false
RECAPTCHA_GOOGLE_CLOUD_PROJECT_ID=
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_VENDOR_WEB_SITE_KEY=
RECAPTCHA_VENDOR_WEB_ALLOWED_HOSTNAMES=localhost,127.0.0.1
# Optional separate Admin checkbox key and hostnames; blank values reuse Vendor configuration.
RECAPTCHA_ADMIN_WEB_SITE_KEY=
RECAPTCHA_ADMIN_WEB_ALLOWED_HOSTNAMES=
RECAPTCHA_TIMEOUT_SECONDS=5
BOT_STEP_UP_TTL_MINUTES=5

FILESYSTEM_DISK=s3
